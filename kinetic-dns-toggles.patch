@@ -0,0 +1,62 @@
+#!/usr/bin/env bash
+# Turns on per-device DNS policy on kinetic-relay-01, which is what makes the
+# console's Tracker Blocker and Malware Shield toggles real (see the
+# "Per-device DNS policy" section of infra/relay_peer_service.py).
+#
+# Run from Cloud Shell, in the repo root, after committing the updated
+# infra/relay_peer_service.py (this script copies it from your checkout).
+#
+# Safe to re-run. Changes nothing for existing users until they flip a
+# toggle: with no policy file, every device keeps today's behaviour (the
+# relay's filtering resolver).
+set -euo pipefail
+
+PROJECT=kineticmodularvpncybersecurity
+ZONE=us-central1-a
+VM_NAME=kinetic-relay-01
+
+gcloud config set project "$PROJECT"
+
+gcloud compute scp infra/relay_peer_service.py "${VM_NAME}:~/relay_peer_service.py" --zone="$ZONE"
+
+gcloud compute ssh "$VM_NAME" --zone="$ZONE" --command="
+  set -euo pipefail
+  # conntrack lets a toggle take effect on the very next lookup (optional,
+  # the service works without it).
+  sudo apt-get install -y -qq conntrack >/dev/null || true
+  sudo mkdir -p /etc/kinetic
+  sudo mv ~/relay_peer_service.py /opt/relay_peer_service.py
+
+  # Re-create the nat rules from /etc/kinetic/dns-policy.json at boot,
+  # after WireGuard is up (iptables rules don't survive a reboot).
+  sudo tee /etc/systemd/system/kinetic-dns-policy.service >/dev/null <<'UNIT'
+[Unit]
+Description=Kinetic per-device DNS policy (iptables restore)
+After=wg-quick@wg0.service network-online.target
+Wants=network-online.target
+
+[Service]
+Type=oneshot
+WorkingDirectory=/opt
+ExecStart=/usr/bin/python3 /opt/relay_peer_service.py --apply-dns-policy
+RemainAfterExit=yes
+
+[Install]
+WantedBy=multi-user.target
+UNIT
+
+  sudo systemctl daemon-reload
+  sudo systemctl enable --now kinetic-dns-policy
+  sudo systemctl restart relay-peer-service
+  sleep 2
+  sudo systemctl is-active relay-peer-service kinetic-dns-policy
+  echo '--- KINETIC_DNS chain (empty until someone turns a toggle off) ---'
+  sudo iptables -t nat -L KINETIC_DNS -n
+  echo '--- hooks ---'
+  sudo iptables -t nat -S PREROUTING | grep KINETIC_DNS
+"
+
+echo
+echo "Done. Test: turn Tracker Blocker OFF in the console with a device connected,"
+echo "then on that device run:  nslookup doubleclick.net"
+echo "OFF -> a real IP address.  Turn it back ON -> 0.0.0.0."
